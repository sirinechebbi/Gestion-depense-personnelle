{% extends 'base.html.twig' %}

{% block title %}Connexion — GestDépenses{% endblock %}

{% block body %}
<div class="min-vh-100 d-flex align-items-center justify-content-center" style="background:linear-gradient(135deg,#1e1b4b 0%,#312e81 50%,#4f46e5 100%)">
    <div class="w-100" style="max-width:420px;padding:1rem">
        <div class="text-center mb-4">
            <div class="mb-3">
                <span class="rounded-3 p-3 d-inline-block" style="background:rgba(255,255,255,.1)">
                    <i class="bi bi-wallet2 text-white" style="font-size:2rem"></i>
                </span>
            </div>
            <h2 class="text-white fw-bold mb-1">GestDépenses</h2>
            <p class="text-white-50">Gérez vos finances personnelles</p>
        </div>

        <div class="card shadow-lg">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4">Connexion</h5>

                {% if error %}
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>{{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form action="{{ path('app_login') }}" method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Adresse e-mail</label>
                        <input type="email" name="_username" value="{{ last_username }}" class="form-control" placeholder="email@exemple.fr" required autofocus>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-medium">Mot de passe</label>
                        <input type="password" name="_password" class="form-control" placeholder="••••••••" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
                    </button>
                </form>
            </div>
        </div>

        <p class="text-center text-white-50 mt-3">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="text-white fw-semibold">Créer un compte</a>
        </p>
    </div>
</div>
{% endblock %}
