{% extends 'base.html.twig' %}

{% block title %}Nouvelle catégorie — GestDépenses{% endblock %}

{% block body %}
<div class="page-header">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_categorie_index') }}">Catégories</a></li>
            <li class="breadcrumb-item active">Nouvelle</li>
        </ol>
    </nav>
    <h1>Nouvelle catégorie</h1>
</div>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body p-4">
                {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.nom) }}
                    {{ form_widget(form.nom) }}
                    {{ form_errors(form.nom) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.icone) }}
                    {{ form_widget(form.icone) }}
                    {{ form_errors(form.icone) }}
                </div>
                <div class="mb-4">
                    {{ form_label(form.couleur) }}
                    {{ form_widget(form.couleur) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-check-lg me-1"></i> Créer</button>
                    <a href="{{ path('app_categorie_index') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
