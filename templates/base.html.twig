<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}GestDépenses{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --sidebar-width: 260px;
            --primary: #4f46e5;
            --primary-dark: #4338ca;
        }
        body { background: #f8f9fa; font-family: 'Segoe UI', system-ui, sans-serif; }
        .sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background: linear-gradient(180deg, #1e1b4b 0%, #312e81 100%);
            position: fixed;
            top: 0; left: 0;
            padding: 0;
            z-index: 100;
            box-shadow: 4px 0 15px rgba(0,0,0,.15);
        }
        .sidebar-brand {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }
        .sidebar-brand h4 { color: #fff; margin: 0; font-weight: 700; letter-spacing: -0.5px; }
        .sidebar-brand small { color: rgba(255,255,255,.5); font-size: .75rem; }
        .sidebar-nav { padding: 1rem 0; }
        .sidebar-section { padding: .5rem 1.5rem .25rem; color: rgba(255,255,255,.4); font-size: .7rem; text-transform: uppercase; letter-spacing: 1px; }
        .sidebar .nav-link {
            color: rgba(255,255,255,.7);
            padding: .65rem 1.5rem;
            border-radius: 0;
            display: flex; align-items: center; gap: .75rem;
            transition: all .2s;
            font-size: .9rem;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: #fff;
            background: rgba(255,255,255,.1);
            border-left: 3px solid #818cf8;
            padding-left: calc(1.5rem - 3px);
        }
        .sidebar .nav-link i { font-size: 1rem; width: 1.25rem; text-align: center; }
        .sidebar-user {
            position: absolute; bottom: 0; left: 0; right: 0;
            padding: 1rem 1.5rem;
            border-top: 1px solid rgba(255,255,255,.1);
            background: rgba(0,0,0,.2);
        }
        .sidebar-user .user-name { color: #fff; font-weight: 600; font-size: .85rem; }
        .sidebar-user .user-email { color: rgba(255,255,255,.5); font-size: .75rem; }
        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            padding: 2rem;
        }
        .page-header { margin-bottom: 2rem; }
        .page-header h1 { font-size: 1.75rem; font-weight: 700; color: #1e1b4b; margin: 0; }
        .card { border: none; border-radius: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .card-header { background: transparent; border-bottom: 1px solid #f0f0f0; font-weight: 600; }
        .btn-primary { background: var(--primary); border-color: var(--primary); }
        .btn-primary:hover { background: var(--primary-dark); border-color: var(--primary-dark); }
        .stat-card { border-radius: 16px; padding: 1.5rem; color: #fff; }
        .badge-categorie { font-size: .75rem; padding: .35em .75em; border-radius: 20px; }
        .table > tbody > tr:last-child > td { border-bottom: none; }
        .alert { border: none; border-radius: 10px; }
        @media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); }
            .main-content { margin-left: 0; padding: 1rem; }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

{% if app.user %}
<div class="sidebar">
    <div class="sidebar-brand">
        <h4><i class="bi bi-wallet2 me-2"></i>GestDépenses</h4>
        <small>Gestion financière personnelle</small>
    </div>
    <nav class="sidebar-nav">
        <div class="sidebar-section">Principal</div>
        <a href="{{ path('app_dashboard') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
            <i class="bi bi-speedometer2"></i> Tableau de bord
        </a>
        <a href="{{ path('app_depense_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_depense' %}active{% endif %}">
            <i class="bi bi-receipt"></i> Mes dépenses
        </a>
        <a href="{{ path('app_depense_new') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_depense_new' %}active{% endif %}">
            <i class="bi bi-plus-circle"></i> Nouvelle dépense
        </a>

        <div class="sidebar-section mt-2">Paramètres</div>
        <a href="{{ path('app_categorie_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_categorie' %}active{% endif %}">
            <i class="bi bi-tags"></i> Catégories
        </a>
        <a href="{{ path('app_logout') }}" class="nav-link">
            <i class="bi bi-box-arrow-right"></i> Déconnexion
        </a>
    </nav>
    <div class="sidebar-user">
        <div class="d-flex align-items-center gap-2">
            <div class="rounded-circle bg-indigo text-white d-flex align-items-center justify-content-center" style="width:36px;height:36px;background:#818cf8;font-weight:700;">
                {{ app.user.prenom|first|upper }}
            </div>
            <div>
                <div class="user-name">{{ app.user.nomComplet }}</div>
                <div class="user-email">{{ app.user.email }}</div>
            </div>
        </div>
    </div>
</div>
{% endif %}

<div class="{% if app.user %}main-content{% else %}container-fluid{% endif %}">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                <i class="bi bi-{% if type == 'success' %}check-circle{% elseif type == 'error' %}exclamation-triangle{% else %}info-circle{% endif %} me-2"></i>
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
