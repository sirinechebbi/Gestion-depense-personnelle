{% extends 'base.html.twig' %}

{% block title %}Catégories — GestDépenses{% endblock %}

{% block body %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1>Catégories</h1>
        <p class="text-muted mb-0">{{ categories|length }} catégorie(s)</p>
    </div>
    <a href="{{ path('app_categorie_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Nouvelle catégorie
    </a>
</div>

<div class="row g-3">
    {% for categorie in categories %}
        <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 flex-shrink-0" style="background:{{ categorie.couleur }}20">
                        <i class="bi {{ categorie.icone }} fs-4" style="color:{{ categorie.couleur }}"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <h6 class="mb-0 text-truncate">{{ categorie.nom }}</h6>
                        <small class="text-muted">{{ categorie.depenses|length }} dépense(s)</small>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{ path('app_categorie_edit', {id: categorie.id}) }}"><i class="bi bi-pencil me-2"></i>Modifier</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form action="{{ path('app_categorie_delete', {id: categorie.id}) }}" method="post" onsubmit="return confirm('Supprimer cette catégorie ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Supprimer</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center text-muted py-5">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            <p>Aucune catégorie.</p>
            <a href="{{ path('app_categorie_new') }}" class="btn btn-primary btn-sm">Créer une catégorie</a>
        </div>
    {% endfor %}
</div>
{% endblock %}
