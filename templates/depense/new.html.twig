{% extends 'base.html.twig' %}

{% block title %}Nouvelle dépense — GestDépenses{% endblock %}

{% block body %}
<div class="page-header">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_depense_index') }}">Dépenses</a></li>
            <li class="breadcrumb-item active">Nouvelle dépense</li>
        </ol>
    </nav>
    <h1>Nouvelle dépense</h1>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.libelle) }}
                    {{ form_widget(form.libelle) }}
                    {{ form_errors(form.libelle) }}
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        {{ form_label(form.montant) }}
                        {{ form_widget(form.montant) }}
                        {{ form_errors(form.montant) }}
                    </div>
                    <div class="col-6">
                        {{ form_label(form.date) }}
                        {{ form_widget(form.date) }}
                        {{ form_errors(form.date) }}
                    </div>
                </div>
                <div class="mb-3">
                    {{ form_label(form.categorie) }}
                    {{ form_widget(form.categorie) }}
                    {{ form_errors(form.categorie) }}
                </div>
                <div class="mb-4">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-check-lg me-1"></i> Enregistrer
                    </button>
                    <a href="{{ path('app_depense_index') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
